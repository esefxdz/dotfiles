/* Rofi config - Hayase Yuuka / Caelestia shadotheme */

configuration {
    modi:           "drun,run,window";
    show-icons:     true;
    icon-theme:     "Papirus-Dark";
    font:           "JetBrainsMono Nerd Font 12";
    drun-display-format: "{name}";
    hover-select:   true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

* {
    bg:         #131317;
    bg-alt:     #1f1f23;
    bg-sel:     #282b60;
    fg:         #e5e1e7;
    fg-muted:   #918f9a;
    accent:     #bfc1ff;
    border-col: #6f72ac;

    background-color: transparent;
    text-color:       @fg;
}

window {
    background-color: @bg;
    border:           2px solid;
    border-color:     @border-col;
    border-radius:    16px;
    width:            480px;
    padding:          12px;
}

mainbox {
    background-color: transparent;
    children:         [ inputbar, listview ];
    spacing:          10px;
}

inputbar {
    background-color: @bg-alt;
    border-radius:    10px;
    padding:          10px 14px;
    children:         [ prompt, entry ];
    spacing:          8px;
}

prompt {
    text-color: @accent;
    font:       "JetBrainsMono Nerd Font Bold 12";
}

entry {
    background-color: transparent;
    placeholder:      "Search...";
    placeholder-color: @fg-muted;
}

listview {
    background-color: transparent;
    lines:            8;
    columns:          1;
    spacing:          4px;
    scrollbar:        false;
}

element {
    background-color: transparent;
    border-radius:    8px;
    padding:          8px 12px;
    spacing:          10px;
    children:         [ element-icon, element-text ];
}

element selected {
    background-color: @bg-sel;
    text-color:       @accent;
}

element-icon {
    size:             24px;
    vertical-align:   0.5;
}

element-text {
    vertical-align: 0.5;
    text-color:     inherit;
}
