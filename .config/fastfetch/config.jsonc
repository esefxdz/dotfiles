{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch",
    "color": {
      "1": "blue",
      "2": "cyan"
    }
  },
  "display": {
    "separator": " : ",
    "color": {
      "separator": "blue"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "cyan",
        "at": "blue",
        "host": "cyan"
      }
    },
    "break",
    {
      "type": "os",
      "key": "        os",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "    kernel",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": "      pkgs",
      "keyColor": "blue"
    },
    {
      "type": "shell",
      "key": "     shell",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "  terminal",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": "        wm",
      "keyColor": "blue"
    },
    "break",
    {
      "type": "cpu",
      "key": "       cpu",
      "keyColor": "blue"
    },
    {
      "type": "gpu",
      "key": "       gpu",
      "keyColor": "blue"
    },
    {
      "type": "memory",
      "key": "    memory",
      "keyColor": "blue"
    },
    {
      "type": "disk",
      "key": "      disk",
      "keyColor": "blue"
    },
    {
      "type": "uptime",
      "key": "    uptime",
      "keyColor": "blue"
    },
    "break"
  ]
}
